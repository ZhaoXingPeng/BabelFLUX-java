# Shared local development defaults.
APP_ENV=development

# Java backend（host/port are read by Spring Boot）
SERVER_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/app.db
MODEL_PROVIDER=mock

# Model providers. Keep real keys in .env only.
# 注意：七牛云 maas 专属域名（ws-xxx.cn-beijing.maas.aliyuncs.com）证书与主机名不匹配，
# 实测须走标准华北2(北京)端点 dashscope.aliyuncs.com，并通过 X-DashScope-WorkSpace
# 头携带业务空间 ID（即 DASHSCOPE_WORKSPACE_ID）。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WEBSOCKET_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1
DASHSCOPE_REQUEST_TIMEOUT_SECONDS=120
DASHSCOPE_WEBSOCKET_TIMEOUT_SECONDS=30
DASHSCOPE_TLS_VERIFY=true
DASHSCOPE_DATA_INSPECTION=

# ===== 模型选型（已实测可用，详见 docs/backend/模型链路与选型_AI同声传译.md）=====
# 核心实时同传引擎：一条 WebSocket 完成 源语音识别 + 翻译（+ 可选中文语音）
LIVE_TRANSLATE_MODEL=qwen3.5-livetranslate-flash-realtime
LIVE_TRANSLATE_ASR_MODEL=qwen3-asr-flash-realtime
# 实时纠偏（跨句轻量复核，低延迟优先）
REALTIME_REVISION_MODEL=qwen-flash
# 会后完整纠偏（强一致；可换 qwen3-max / deepseek-v4-pro，均已实测可用）
FINAL_CORRECTION_MODEL=qwen-plus
FINAL_CORRECTION_TIMEOUT_SECONDS=120
# 可选中文语音合成（仅 ttsEnabled 时启用）
TTS_MODEL=qwen3-tts-flash-realtime
TTS_VOICE=Tina

# 安全开关：生产环境建议开启模型网关鉴权，并用逗号分隔限制在线媒体 URL host。
REQUIRE_MODEL_GATEWAY_AUTH=false
ALLOWED_MEDIA_HOSTS=

# demo 模式真实样例（指向本机存在的音视频文件时用真实管线跑该样例；为空则回退演示事件流）
DEMO_MEDIA_PATH=

# 运行期产物目录（相对仓库根；已 gitignore）
MEDIA_STORAGE_DIR=backend/data/media
REPORT_STORAGE_DIR=backend/data/reports

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BACKEND_WS_URL=ws://localhost:8000/api

# Java middleware switches. Keep disabled for the in-memory local profile.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=false
MYSQL_URL=jdbc:mysql://localhost:3306/babelflux
MYSQL_USERNAME=babelflux
MYSQL_PASSWORD=
MYSQL_DRIVER=com.mysql.cj.jdbc.Driver
MYSQL_ENABLED=false
