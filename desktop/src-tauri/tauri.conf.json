{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BabelFlux Floating Caption",
  "version": "0.1.1",
  "identifier": "com.babelflux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "BabelFlux",
        "width": 860,
        "height": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lingosync"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Desktop floating captions for BabelFlux",
    "longDescription": "Transparent always-on-top floating caption overlay for BabelFlux sessions."
  }
}
